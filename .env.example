# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-64-hex-characters-generated-randomly
# Production requires Neon Postgres; SQLite remains for local testing only
DATABASE_URL=
DB_PATH=./data/reviewforge.sqlite
# Worker endpoint: use a strong independent secret
WORKER_SECRET=
DEMO_MODE=true
# Start in SAFE MODE. live will publish reviews and potentially incur AI/GitHub costs.
REVIEW_POST_MODE=dry-run
# Cost safety: key alone will NOT enable webhook-triggered model calls
AI_REVIEW_ENABLED=false

# Your own GitHub App (GitHub Settings -> Developer settings -> GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PEM as literal newlines or escaped \\n, private key must remain on the server
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# OpenAI Responses API; no AI review is run without this key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Stripe subscriptions (test mode first)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Proffera shadow pilot: force dry-run for these repositories, even when global mode changes.
AI_SHADOW_REPOSITORIES=

# Proffera shadow pilot only; no daily review count cap, no GitHub comments.
AI_UNLIMITED_REPOSITORIES=
AI_AUTO_MODEL_REPOSITORIES=
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_DEEP=gpt-6.1-sol

# Only review these repositories after a verified CodeRabbit rate-limit event.
AI_FALLBACK_ONLY_REPOSITORIES=

# Separately enable fallback GitHub APPROVE/comment after verification; otherwise dry-run.
AI_FALLBACK_APPROVAL_REPOSITORIES=

# Authenticated, click-to-review shadow pilot; no comments/approvals/merges.
AI_MANUAL_REVIEW_REPOSITORIES=

# API access for trusted Workers to request exact-HEAD shadow reviews only.
# Requires existing WORKER_SECRET (at least 32 chars) and manual/AI/shadow allowlists.
AI_WORKER_REQUEST_REPOSITORIES=
